# Statický web — přejmenuj na Dockerfile a nech jen jednu z variant níže.
# nginx:alpine poslouchá na 0.0.0.0:80 → v docker-compose.yml "{{upstreams 80}}".

# ── Varianta A: čisté HTML/CSS/JS bez buildu (soubory v ./public) ──
FROM nginx:alpine
COPY public/ /usr/share/nginx/html/

# ── Varianta B: build přes Bun (Vite, Astro, …), výstup v ./dist ──
# FROM oven/bun:1 AS build
# WORKDIR /app
# COPY package.json bun.lock ./
# RUN bun install --frozen-lockfile
# COPY . .
# RUN bun run build
#
# FROM nginx:alpine
# COPY --from=build /app/dist/ /usr/share/nginx/html/
#
# SPA s client-side routingem (React Router apod.) potřebuje fallback na
# index.html — přidej vlastní nginx config s "try_files $uri $uri/ /index.html;"
# a COPY nginx.conf /etc/nginx/conf.d/default.conf
