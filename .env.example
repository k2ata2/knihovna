# Tento soubor NIKDY necommituj do gitu.
# Skutečný .env žije jen na VPS: /opt/apps/<APP_NAME>/.env — vytvoř ho tam ručně
# přes SSH (scp/nano) při prvním nasazení appky. CI se .env nikdy nedotýká.
#
# .env je potřeba JEN pokud appka nějaké proměnné má. Statický web ho
# nepotřebuje vůbec (a docker-compose.static.yml ho ani nenačítá).

# Jen pro appku s DB (docker-compose.with-db.yml):
POSTGRES_DB=appname
POSTGRES_USER=appname
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://appname:changeme@postgres:5432/appname

# Aplikačně specifické proměnné / API klíče podle potřeby:
# SOME_API_KEY=
